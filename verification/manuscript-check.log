ModifiedCartan.projective_equivalence {p : ℕ} (hp : 3 ≤ p) {R : ℝ} (hR : 0 < R) (hR1 : R ≤ 1) :
  ModifiedCartan.PartitionProperty p (ModifiedCartan.disk R) ↔
    ModifiedCartan.ProjectiveMapPartitionProperty ⟨0, ⋯⟩ (ModifiedCartan.disk R)
ModifiedCartan.projective_zero_directions {p : ℕ} (k : Fin p) [Nonempty ↑(ModifiedCartan.ProjectiveX p)]
  (x : ↑(ModifiedCartan.ProjectiveX p)) :
  {v | ModifiedCartan.manifoldKobayashiRoyden x v = 0} =
    ⋃ P,
      ⋃ (hP : ModifiedCartan.IsAdmissiblePartition (ModifiedCartan.projectiveXNormalize k x) P),
        ↑(ModifiedCartan.projectiveTorusTangentSpace k x P hP)
ModifiedCartan.projectiveTorusTangentSpace_finrank_le {p : ℕ} (k : Fin p) [Nonempty ↑(ModifiedCartan.ProjectiveX p)]
  (x : ↑(ModifiedCartan.ProjectiveX p)) (P : ModifiedCartan.IndexPartition p)
  (hP : ModifiedCartan.IsAdmissiblePartition (ModifiedCartan.projectiveXNormalize k x) P) :
  Module.finrank ℂ ↥(ModifiedCartan.projectiveTorusTangentSpace k x P hP) ≤ p / 2 - 1
