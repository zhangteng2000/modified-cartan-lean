ModifiedCartan.envelope_lemma {m : ℕ} {u : Fin m → ℂ → ℝ} {U : ℂ → ℝ} {ρ δ η C₀ : ℝ} (hρ : 1 / 2 ≤ ρ) (hρ' : ρ ≤ 3 / 4)
  (hδ : 0 < δ) (hδη : δ ≤ η) (hη : η ≤ 1 / 64) (hC : 0 ≤ C₀)
  (hu : ∀ (i : Fin m), InnerProductSpace.HarmonicOnNhd (u i) (Metric.closedBall 0 ρ))
  (hU : InnerProductSpace.HarmonicContOnCl U (Metric.ball 0 ρ))
  (hboundary : ∀ z ∈ Metric.sphere 0 ρ, IsGreatest (Set.range fun i => u i z) (U z) ∧ 0 < U z)
  (hpoints : ∀ (i : Fin m), ∃ z ∈ Metric.ball 0 δ, u i z ≤ C₀) (i : Fin m) :
  u i 0 ≤ 8 * δ * U 0 + C₀ ∧ sSup (u i '' Metric.closedBall 0 (4 * η)) ≤ 64 * η * U 0 + C₀
