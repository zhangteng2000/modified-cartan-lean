ModifiedCartan.torus_manifold_null_image_eq_zeroLocus.{u_1, u_2} {E : Type u_1} [NormedAddCommGroup E] [NormedSpace ℂ E]
  {M : Type u_2} [TopologicalSpace M] [ChartedSpace E M] [IsManifold (modelWithCornersSelf ℂ E) 1 M] {N : ℕ}
