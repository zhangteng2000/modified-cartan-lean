ModifiedCartan.explicitAbsorptionTheorem_proved : ModifiedCartan.ExplicitAbsorptionTheorem
ModifiedCartan.absorption_at_recursive_radius {K : ℕ → ℝ} (hK : ModifiedCartan.WronskianExponents K)
  (hKm : ∀ (m : ℕ), ↑m ≤ K m) (m : ℕ) :
  1 ≤ m → ModifiedCartan.AbsorptionAt m (ModifiedCartan.disk (ModifiedCartan.absorptionRadius K m))
ModifiedCartan.rank_adaptive_absorption {K : ℕ → ℝ} (hK : ModifiedCartan.WronskianExponents K)
  (hKm : ∀ (m : ℕ), ↑m ≤ K m) (m d : ℕ) :
  1 ≤ d →
    d ≤ m →
      ∀ (A a : ModifiedCartan.Family m) (s : ℂ → ℂ),
        ModifiedCartan.UnitFamily A →
          (∀ (i : Fin m) (n : ℕ), DifferentiableOn ℂ (a i n) (ModifiedCartan.disk 1)) →
            (∀ (i : Fin m),
                ModifiedCartan.CompactConvergence (fun n z => a i n z / A i n z) (fun x => 0) (ModifiedCartan.disk 1)) →
              ModifiedCartan.CompactConvergence (fun n z => ∑ i, a i n z) s (ModifiedCartan.disk 1) →
                (∃ z ∈ ModifiedCartan.disk 1, s z ≠ 0) →
                  (∀ (n : ℕ), ModifiedCartan.functionRank (fun i => a i n) (ModifiedCartan.disk 1) ≤ d) →
                    ∃ i φ,
                      StrictMono φ ∧
                        ModifiedCartan.CompactConvergence (fun n z => (A i (φ n) z)⁻¹) (fun x => 0)
                          (ModifiedCartan.disk (ModifiedCartan.absorptionRadius K d))
ModifiedCartan.stabilization_lemma {p : ℕ} (hp : 1 ≤ p) {f : ModifiedCartan.Family p} (hf : ModifiedCartan.UnitFamily f)
  {σ : ℝ} (hσ : 0 < σ) (hσ1 : σ < 1) :
  ∃ φ,
    ∃ (_ : StrictMono φ),
      (∀ (i j k : Fin p),
          ModifiedCartan.HolomorphicLimitOrEscape (fun n z => f i (φ n) z / f j (φ n) z)
            (ModifiedCartan.disk (σ ^ ↑k))) ∧
        have R := ModifiedCartan.diskQuotientPreorder (ModifiedCartan.subsequence f φ) ⋯ σ ⋯ ⋯;
        ∃ l < p,
          (ModifiedCartan.maximalClasses (R l)).card = 1 ∨
            l + 1 < p ∧
              ∀ (x y : Fin p),
                ModifiedCartan.PreorderMaximal (R l) x →
                  ModifiedCartan.PreorderMaximal (R l) y →
                    ¬((R l).rel x y ∧ (R l).rel y x) → ¬(R (l + 1)).rel x y ∧ ¬(R (l + 1)).rel y x
ModifiedCartan.partition_at_center {p : ℕ} (hp : 3 ≤ p) {K : ℕ → ℝ} (hK : ModifiedCartan.WronskianExponents K)
  (hKm : ∀ (m : ℕ), ↑m ≤ K m) {a : ℂ} (ha : a ∈ ModifiedCartan.disk 1) :
  ModifiedCartan.PartitionProperty p
    {z | z ∈ ModifiedCartan.disk 1 ∧ ‖(z - a) / (1 - star a * z)‖ < ModifiedCartan.absorptionRadius K (p - 1) ^ (p - 1)}
ModifiedCartan.two_point_harmonic {q : ℝ} (hq : 0 < q) (hqr : q < ModifiedCartan.sharpRadius) :
  ∃ ε,
    0 < ε ∧
      ∀ (U : ℂ → ℝ),
        InnerProductSpace.HarmonicOnNhd U (Metric.ball 0 1) →
          (∀ z ∈ Metric.ball 0 1, 0 < U z) →
            ∀ (t s : ℝ),
              0 ≤ t →
                t ≤ q →
                  |s| ≤ t →
                    (1 + ε) * U ↑s ≤ ModifiedCartan.twoPointMinus t s * U ↑(-t) + ModifiedCartan.twoPointPlus t s * U ↑t
ModifiedCartan.geodesic_harmonic_comparison {d₀ : ℝ} (hd₀ : 0 < d₀) (hd₃ : d₀ < Real.log 3) :
  ∃ ε,
    0 < ε ∧
      ∀ (a b : ℂ),
        a ∈ ModifiedCartan.disk 1 →
          b ∈ ModifiedCartan.disk 1 →
            ModifiedCartan.hyperbolicDistance a b ≤ d₀ →
              ∀ (U P Q : ℂ → ℝ) (C₀ : ℝ),
                InnerProductSpace.HarmonicOnNhd U (ModifiedCartan.disk 1) →
                  InnerProductSpace.HarmonicOnNhd P (ModifiedCartan.disk 1) →
                    InnerProductSpace.HarmonicOnNhd Q (ModifiedCartan.disk 1) →
                      (∀ z ∈ ModifiedCartan.disk 1, 0 < U z) →
                        (∀ z ∈ ModifiedCartan.disk 1, 0 ≤ P z) →
                          (∀ z ∈ ModifiedCartan.disk 1, 0 ≤ Q z) →
                            0 ≤ C₀ →
                              U a - C₀ ≤ Q a →
                                U b - C₀ ≤ P b →
                                  ∀ z ∈ ModifiedCartan.hyperbolicSegment a b, U z - P z - Q z ≤ -ε * U z + 2 * C₀
